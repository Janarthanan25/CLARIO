# ==============================================================================
# CLARIO Platform Environment Configuration Template
# Copy this file to .env and configure your environment-specific credentials.
# NEVER commit your actual .env file or sensitive secrets to version control.
# ==============================================================================

# Flask Core Application Settings
FLASK_APP=app.py
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=replace-with-a-secure-random-32-byte-hex-string-for-production

# Google Gemini AI API Configuration
# Get your API key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

# PayPal Sandbox Credentials (REST API v2)
# Obtain from PayPal Developer Dashboard: https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_client_secret_here
PAYPAL_MODE=sandbox
PAYPAL_WEBHOOK_ID=your_paypal_webhook_id_here

# Database Configuration (Defaults to local SQLite instance/clario.db)
# For production PostgreSQL / MySQL:
# DATABASE_URL=postgresql://user:password@localhost:5432/clariodb
