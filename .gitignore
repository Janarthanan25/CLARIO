# ==============================================================================
# CLARIO Git Ignore Configuration
# Protects secrets, virtual environments, local databases, and temporary assets
# ==============================================================================

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
venv/
env/
ENV/
.venv/
env.bak/
venv.bak/

# Environment variables & secrets (NEVER COMMIT REAL CREDENTIALS)
.env
.env.*
!.env.example
*.env
*.pem
*.key
*.cert
*.pfx
*.p12

# Local SQLite databases & instance storage
instance/*
!instance/.gitkeep
*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-wal

# Dynamic user uploads & document storage
uploads/*
!uploads/.gitkeep

# Unit test / coverage / cache
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/

# Application runtime logs
*.log
logs/

# Operating system files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# IDE & Editor files
.idea/
.vscode/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~
